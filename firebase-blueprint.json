          "type": "number",
          "description": "Epoch milliseconds of last heartbeat"
        },
        "visibility": {
          "type": "string",
          "maxLength": 32,
          "enum": ["edu_verified"],
          "description": "Visibility scope"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of heartbeat"
        }
      },
      "required": [
        "uid",
        "nickname",
        "photoURL",
        "badge",
        "campus",
        "isOnline",
        "lastSeenMs",
        "visibility",
        "updatedAt"
      ]
    },
    "Post": {
      "title": "Post",
      "description": "Student rant or situation post with optional photo, video, PDF, Word, Excel, or PowerPoint attachment.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the post author"
        },
        "authorNickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Author's nickname or Anonymous MSUan"
        },
        "authorDisplayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Author's Gmail display name or hidden label"
        },
        "authorPhotoURL": {
          "type": "string",
          "maxLength": 2048,
          "description": "Author's Gmail profile photo URL"
        },
        "authorDomain": {
          "type": "string",
          "maxLength": 64,
          "description": "Institutional domain badge of the author"
        },
        "authorBadge": {
          "type": "string",
          "maxLength": 20,
          "enum": ["verified", "moderator", "developer", "tulips"],
          "description": "Author's badge ('verified', 'moderator', 'developer', or 'tulips')"
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether the post hides the author's Gmail identity and nickname"
        },
        "category": {
          "type": "string",
          "maxLength": 40,
          "enum": [
            "Academic Rant",
            "Campus Life",
            "Dorm & Housing",
            "Prof & Subjects",
            "Org & Events",
            "Study Materials",
            "General Rant"
          ],
          "description": "Rant or post category"
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional headline for the rant or shared material"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Main body text of the rant or post"
        },
        "attachmentType": {
          "type": "string",
          "maxLength": 16,
          "enum": ["none", "photo", "video", "pdf", "word", "excel", "ppt"],
          "description": "Type of file attached to the post"
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 255,
          "description": "Original filename of the attachment"
        },
        "attachmentSize": {
          "type": "number",
          "description": "File size in bytes"
        },
        "attachmentMime": {
          "type": "string",
          "maxLength": 120,
          "description": "MIME type of the attachment"
        },
        "attachmentDataUrl": {
          "type": "string",
          "maxLength": 750000,
          "description": "Data URL or preview payload of the uploaded file"
        },
        "likesCount": {
          "type": "number",
          "description": "Count of damay/support reactions"
        },
        "commentsCount": {
          "type": "number",
          "description": "Count of student comments"
        },
        "visibility": {
          "type": "string",
          "maxLength": 32,
          "enum": ["edu_verified"],
          "description": "Access control scope for verified .edu.ph students"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when post was published"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when post was last updated"
        }
      },
      "required": [
        "authorId",
        "authorNickname",
        "authorDisplayName",
        "authorPhotoURL",
        "authorDomain",
        "authorBadge",
        "isAnonymous",
        "category",
        "title",
        "content",
        "attachmentType",
        "attachmentName",
        "attachmentSize",
        "attachmentMime",
        "attachmentDataUrl",
        "likesCount",
        "commentsCount",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
