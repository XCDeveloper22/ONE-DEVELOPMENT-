        },
        "passwordUpdatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp when password was last changed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of private record creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of private record update"
        }
      },
      "required": [
        "uid",
        "email",
        "hasCustomPassword",
        "passwordUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "NicknameReservation": {
      "title": "NicknameReservation",
