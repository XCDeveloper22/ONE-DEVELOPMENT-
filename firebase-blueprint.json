{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public student profile displaying Gmail avatar, display name, verified/developer badge, and unique nickname subject to a 60-day change cooldown.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the student"
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "description": "Unique student nickname changeable once every 2 months (60 days)"
        },
        "nicknameUpdatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp when nickname was last set or changed"
        },
        "googleDisplayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Student's Gmail profile display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 2048,
          "description": "Student's Gmail profile photo URL"
        },
        "emailDomain": {
          "type": "string",
          "maxLength": 64,
          "description": "Verified institutional domain such as s.msumain.edu.ph"
        },
        "campus": {
          "type": "string",
          "maxLength": 80,
          "description": "MSU campus affiliation"
        },
        "bio": {
          "type": "string",
          "maxLength": 280,
          "description": "Short student bio or status"
        },
        "defaultAnonymous": {
          "type": "boolean",
          "description": "Whether student posts and comments default to anonymous mode"
        },
        "badge": {
          "type": "string",
          "maxLength": 20,
          "enum": ["verified", "moderator", "developer", "tulips"],
          "description": "Account badge assigned upon creation: 'developer' for xandercamarin@gmail.com, 'tulips' for delecernaahrene122008@gmail.com, 'verified' for all other users"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": [
        "uid",
        "nickname",
        "nicknameUpdatedAt",
        "googleDisplayName",
        "photoURL",
        "emailDomain",
        "campus",
        "bio",
        "defaultAnonymous",
        "badge",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
