        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "targetType",
        "targetId",
        "targetAuthorId",
        "targetAuthorNickname",
        "targetPreview",
        "reporterId",
        "reporterNickname",
        "reason",
        "status",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ModerationRule": {
      "title": "ModerationRule",
      "description": "Platform moderation rule and keyword filter configured by developers.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "severity": {
          "type": "string",
          "enum": ["warn", "hide", "block"]
        },
        "keywords": {
          "type": "string",
          "maxLength": 1000
        },
        "isActive": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "visibility": {
          "type": "string",
          "enum": ["edu_verified"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "severity",
        "keywords",
        "isActive",
        "createdBy",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global website controls, branding, feature flags, announcements, and maintenance mode.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 80 },
        "siteTagline": { "type": "string", "maxLength": 160 },
        "logoText": { "type": "string", "maxLength": 24 },
        "logoImageUrl": { "type": "string", "maxLength": 2048 },
        "primaryColor": { "type": "string", "maxLength": 32 },
        "accentColor": { "type": "string", "maxLength": 32 },
        "allowNewPosts": { "type": "boolean" },
        "allowComments": { "type": "boolean" },
        "allowFileUploads": { "type": "boolean" },
        "allowDirectChat": { "type": "boolean" },
        "allowAnonymousMode": { "type": "boolean" },
        "allowSuggestionBox": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 500 },
        "announcementActive": { "type": "boolean" },
        "announcementTitle": { "type": "string", "maxLength": 160 },
        "announcementText": { "type": "string", "maxLength": 1000 },
        "systemNoticeActive": { "type": "boolean" },
        "systemNoticeText": { "type": "string", "maxLength": 500 },
        "systemNoticeType": { "type": "string", "enum": ["info", "warning", "urgent"] },
        "deletedPostIds": { "type": "array", "description": "List of permanently deleted post IDs synced across clients" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "visibility": { "type": "string", "enum": ["edu_verified"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "siteName",
        "logoText",
        "primaryColor",
        "accentColor",
        "allowNewPosts",
        "allowComments",
        "allowFileUploads",
        "allowDirectChat",
        "allowAnonymousMode",
        "allowSuggestionBox",
        "maintenanceMode",
        "visibility"
      ]
    },
    "CommentReaction": {
      "title": "CommentReaction",
      "description": "Specific emoji reaction by a verified student on a comment within a post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "emoji": {
          "type": "string",
          "enum": ["❤️", "😂", "😮", "😢", "🔥", "👏"]
        },
        "visibility": {
          "type": "string",
          "enum": ["edu_verified"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["postId", "commentId", "userId", "emoji", "visibility", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public student profiles containing nickname, cooldown timestamp, badge, and Gmail avatar."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-isolated private student record containing full .edu.ph email and password state."
    },
    "/nicknames/{nicknameId}": {
      "schema": { "$ref": "#/entities/NicknameReservation" },
      "description": "Unique nickname registry preventing duplicate nicknames across students."
    },
    "/presence/{userId}": {
      "schema": { "$ref": "#/entities/UserPresence" },
      "description": "Real-time online presence records for verified users."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Student rants and academic file posts."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments belonging to a specific post."
    },
    "/posts/{postId}/reactions/{userId}": {
      "schema": { "$ref": "#/entities/Reaction" },
      "description": "Individual user reactions on a specific post."
    },
    "/posts/{postId}/comment_reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/CommentReaction" },
      "description": "Emoji reactions on comments within a specific post."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications for likes, comments, and chat messages."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "1-on-1 chat threads between MSU students."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time messages with photos and Microsoft Office / PDF attachments."
    },
    "/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/Suggestion" },
      "description": "Campus suggestion box ideas and feature requests."
    },
    "/suggestions/{suggestionId}/upvotes/{userId}": {
      "schema": { "$ref": "#/entities/SuggestionUpvote" },
      "description": "Student upvote records on a suggestion."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ContentReport" },
      "description": "Moderation reports submitted on posts, comments, or users."
    },
    "/moderation_rules/{ruleId}": {
      "schema": { "$ref": "#/entities/ModerationRule" },
      "description": "Platform moderation rules and keyword filters."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global website controls, branding, announcements, and feature flags."
    }
  }
}
