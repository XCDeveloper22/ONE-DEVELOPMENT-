      "required": ["uid", "nickname", "updatedAt"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time online presence record for verified MSUan users.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
